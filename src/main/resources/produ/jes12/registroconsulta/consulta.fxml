<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="800.0" spacing="12.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="produ.jes12.registroconsulta.controllers.ConsultaController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Consulta de Clientes" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label text="Doble clic en un registro para ver el detalle (MouseEvent)" textFill="#64748b">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnFiltrar" onAction="#handleFiltrar" prefHeight="34.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;" text="Filtrar por Ciudad (Dialog)">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <TableView fx:id="tblClientes" onMouseClicked="#handleTableClick" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5px;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombreCompleto" prefWidth="200.0" text="Nombre Completo" />
                <TableColumn fx:id="colTipoCliente" prefWidth="130.0" text="Tipo de Cliente" />
                <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad" />
                <TableColumn fx:id="colFechaNacimiento" prefWidth="130.0" text="Fecha de Nacimiento" />
                <TableColumn fx:id="colTipoSolicitud" prefWidth="150.0" text="Tipo de Solicitud" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="btnVolver" onAction="#handleVolver" prefHeight="34.0" prefWidth="95.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-background-radius: 5px; -fx-cursor: hand;" text="Volver">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>