<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="450.0" prefWidth="351.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="produ.jes12.registroconsulta.controllers.LoginController">
    <children>
        <VBox alignment="CENTER" maxWidth="350.0" spacing="18.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="4.0">
                    <children>
                        <Label text="Inicio de Sesión" textFill="#1e293b">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="Acceso al Sistema de Gestión" textFill="#64748b">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="12.0">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Usuario:" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtUsuario" prefHeight="35.0" promptText="Ingrese su usuario" style="-fx-border-color: #cbd5e1; -fx-border-radius: 5px; -fx-background-radius: 5px;" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Contraseña:" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtPassword" prefHeight="35.0" promptText="••••••••" style="-fx-border-color: #cbd5e1; -fx-border-radius: 5px; -fx-background-radius: 5px;" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="btnSalir" onAction="#handleSalir" prefHeight="36.0" prefWidth="120.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 5px; -fx-cursor: hand;" text="Salir">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="btnIniciarSesion" defaultButton="true" onAction="#handleIniciarSesion" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #2563eb; -fx-text-fill: #ffffff; -fx-background-radius: 5px; -fx-cursor: hand;" text="Iniciar Sesión">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
