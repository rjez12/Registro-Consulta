<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="produ.jes12.registroconsulta.controllers.MainController">
    <children>
        <VBox fx:id="rootPane" spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- MenuBar -->
                <MenuBar fx:id="menuBar" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <menus>
                        <Menu text="Gestión">
                            <items>
                                <MenuItem onAction="#abrirVentanaRegistro" text="Registrar Cliente" />
                                <MenuItem onAction="#abrirVentanaConsulta" text="Consultar Clientes" />
                                <SeparatorMenuItem />
                                <MenuItem onAction="#handleCerrarSesion" text="Cerrar Sesión" />
                                <MenuItem onAction="#handleSalir" text="Salir" />
                            </items>
                        </Menu>
                        <Menu text="Herramientas">
                            <items>
                                <MenuItem onAction="#handleSeleccionarCarpeta" text="Seleccionar Carpeta General..." />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <!-- ToolBar -->
                <ToolBar fx:id="toolBar" prefHeight="42.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <items>
                        <Button onAction="#abrirVentanaRegistro" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-background-radius: 5px; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Registrar Cliente" />
                        <Button onAction="#abrirVentanaConsulta" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-background-radius: 5px; -fx-font-weight: bold; -fx-cursor: hand;" text="Consultar Tabla" />
                        <Separator orientation="VERTICAL" />
                        <Button onAction="#handleSeleccionarCarpeta" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 5px; -fx-cursor: hand;" text="Elegir Directorio" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCerrarSesion" style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-cursor: hand;" text="Cerrar Sesión" />
                    </items>
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </ToolBar>

                <!-- Área Central -->
                <VBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Sistema de Gestión de Clientes" textFill="#0f172a">
                                    <font>
                                        <Font name="System Bold" size="22.0" />
                                    </font>
                                </Label>
                                <Label text="Seleccione un módulo para comenzar" textFill="#64748b">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <VBox alignment="CENTER" prefHeight="150.0" prefWidth="220.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <padding>
                                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                    </padding>
                                    <children>
                                        <Label text="Registro de Cliente" textFill="#1e293b">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <Label text="Formulario con foto, datos y expediente." textAlignment="CENTER" textFill="#64748b" wrapText="true">
                                            <font><Font size="11.0" /></font>
                                        </Label>
                                        <Button onAction="#abrirVentanaRegistro" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;" text="Abrir Formulario" />
                                    </children>
                                </VBox>

                                <VBox alignment="CENTER" prefHeight="150.0" prefWidth="220.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                                    <padding>
                                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                    </padding>
                                    <children>
                                        <Label text="Consulta de Clientes" textFill="#1e293b">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <Label text="Tabla de clientes con vista de detalle." textAlignment="CENTER" textFill="#64748b" wrapText="true">
                                            <font><Font size="11.0" /></font>
                                        </Label>
                                        <Button onAction="#abrirVentanaConsulta" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;" text="Abrir Tabla" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>